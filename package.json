{
  "name": "foliocove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-launch.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:installed": "playwright test --project=chrome --project=edge",
    "test:e2e:ocr": "set PRIVYPDF_RUN_OCR=1&& playwright test tests/e2e/ocr.local.spec.mjs --project=chromium"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@fontsource/dm-sans": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "docx": "9.8.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pdfstudio": "0.4.0",
    "pptxgenjs": "4.0.0",
    "qrcode": "1.5.4",
    "read-excel-file": "9.3.10",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.25.10"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "overrides": {
    "image-size": "2.0.3"
  }
}
